{
  "name": "@markpol/dd-srd",
  "version": "6.0.0",
  "description": "Dungeons & Dragons 5th Edition SRD game data (JSON) in English",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.x || 24.x"
  },
  "exports": {
    "./ability-scores": {
      "types": "./types/5e-SRD-Ability-Scores.d.ts",
      "default": "./src/2014/en/5e-SRD-Ability-Scores.json"
    },
    "./alignments": {
      "types": "./types/5e-SRD-Alignments.d.ts",
      "default": "./src/2014/en/5e-SRD-Alignments.json"
    },
    "./backgrounds": {
      "types": "./types/5e-SRD-Backgrounds.d.ts",
      "default": "./src/2014/en/5e-SRD-Backgrounds.json"
    },
    "./classes": {
      "types": "./types/5e-SRD-Classes.d.ts",
      "default": "./src/2014/en/5e-SRD-Classes.json"
    },
    "./conditions": {
      "types": "./types/5e-SRD-Conditions.d.ts",
      "default": "./src/2014/en/5e-SRD-Conditions.json"
    },
    "./damage-types": {
      "types": "./types/5e-SRD-Damage-Types.d.ts",
      "default": "./src/2014/en/5e-SRD-Damage-Types.json"
    },
    "./equipment-categories": {
      "types": "./types/5e-SRD-Equipment-Categories.d.ts",
      "default": "./src/2014/en/5e-SRD-Equipment-Categories.json"
    },
    "./equipment": {
      "types": "./types/5e-SRD-Equipment.d.ts",
      "default": "./src/2014/en/5e-SRD-Equipment.json"
    },
    "./feats": {
      "types": "./types/5e-SRD-Feats.d.ts",
      "default": "./src/2014/en/5e-SRD-Feats.json"
    },
    "./features": {
      "types": "./types/5e-SRD-Features.d.ts",
      "default": "./src/2014/en/5e-SRD-Features.json"
    },
    "./languages": {
      "types": "./types/5e-SRD-Languages.d.ts",
      "default": "./src/2014/en/5e-SRD-Languages.json"
    },
    "./levels": {
      "types": "./types/5e-SRD-Levels.d.ts",
      "default": "./src/2014/en/5e-SRD-Levels.json"
    },
    "./magic-items": {
      "types": "./types/5e-SRD-Magic-Items.d.ts",
      "default": "./src/2014/en/5e-SRD-Magic-Items.json"
    },
    "./magic-schools": {
      "types": "./types/5e-SRD-Magic-Schools.d.ts",
      "default": "./src/2014/en/5e-SRD-Magic-Schools.json"
    },
    "./monsters-normalized": {
      "types": "./types/5e-SRD-Monsters-Normalized.d.ts",
      "default": "./src/2014/5e-SRD-Monsters-Normalized.json"
    },
    "./monsters": {
      "types": "./types/5e-SRD-Monsters.d.ts",
      "default": "./src/2014/en/5e-SRD-Monsters.json"
    },
    "./proficiencies": {
      "types": "./types/5e-SRD-Proficiencies.d.ts",
      "default": "./src/2014/en/5e-SRD-Proficiencies.json"
    },
    "./races": {
      "types": "./types/5e-SRD-Races.d.ts",
      "default": "./src/2014/en/5e-SRD-Races.json"
    },
    "./rule-sections": {
      "types": "./types/5e-SRD-Rule-Sections.d.ts",
      "default": "./src/2014/en/5e-SRD-Rule-Sections.json"
    },
    "./rules": {
      "types": "./types/5e-SRD-Rules.d.ts",
      "default": "./src/2014/en/5e-SRD-Rules.json"
    },
    "./skills": {
      "types": "./types/5e-SRD-Skills.d.ts",
      "default": "./src/2014/en/5e-SRD-Skills.json"
    },
    "./spells": {
      "types": "./types/5e-SRD-Spells.d.ts",
      "default": "./src/2014/en/5e-SRD-Spells.json"
    },
    "./subclasses": {
      "types": "./types/5e-SRD-Subclasses.d.ts",
      "default": "./src/2014/en/5e-SRD-Subclasses.json"
    },
    "./subraces": {
      "types": "./types/5e-SRD-Subraces.d.ts",
      "default": "./src/2014/en/5e-SRD-Subraces.json"
    },
    "./traits": {
      "types": "./types/5e-SRD-Traits.d.ts",
      "default": "./src/2014/en/5e-SRD-Traits.json"
    },
    "./weapon-properties": {
      "types": "./types/5e-SRD-Weapon-Properties.d.ts",
      "default": "./src/2014/en/5e-SRD-Weapon-Properties.json"
    },
    "./src/2014/en/*.json": "./src/2014/en/*.json",
    "./src/2014/5e-SRD-Monsters-Normalized.json": "./src/2014/5e-SRD-Monsters-Normalized.json",
    "./src/provenance/source-markers.json": "./src/provenance/source-markers.json",
    "./src/i18n/localize": "./src/i18n/localize.ts",
    "./src/i18n/localize.ts": "./src/i18n/localize.ts",
    "./schema/*.json": "./schema/*.json",
    "./ids/*.json": "./ids/*.json",
    "./types/*.d.ts": "./types/*.d.ts",
    "./types/*": "./types/*.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/2014/en/*.json",
    "src/2014/5e-SRD-Monsters-Normalized.json",
    "src/provenance/source-markers.json",
    "schema/*.json",
    "types/*.d.ts",
    "ids/*.json",
    "src/i18n/localize.ts",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "normalize:monsters": "node --experimental-strip-types --no-warnings src/2014/normalize-monsters.ts",
    "derive:spells": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs src/2014/derive-spell-mechanics.ts",
    "derive:classes": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs src/2014/derive-class-choices.ts",
    "derive:spellcasting": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs src/2014/derive-class-spellcasting.ts",
    "derive:features": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs src/2014/derive-feature-engine.ts",
    "generate": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs scripts/generate-schemas.ts",
    "generate:check": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs scripts/generate-schemas.ts --check",
    "i18n:coverage": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs scripts/i18n-coverage.ts",
    "lint": "eslint . --config eslint.config.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "exports:write": "node --experimental-strip-types --no-warnings --import ./scripts/register-ts.mjs scripts/package-exports.ts",
    "test:package": "node --experimental-strip-types --no-warnings scripts/smoke-pack.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markpol/5e-database.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/markpol/5e-database/issues"
  },
  "homepage": "https://github.com/markpol/5e-database#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
