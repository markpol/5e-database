{
  "name": "5e-database",
  "version": "5.12.0",
  "description": "Dungeons & Dragons 5th Edition SRD game data (JSON) in English, French, Portuguese and Russian",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.x || 24.x"
  },
  "files": [
    "src/2014/en/*.json",
    "src/2014/fr-FR/*.json",
    "src/2014/pt-BR/*.json",
    "src/2014/ru/*.json",
    "src/2014/5e-SRD-Monsters-Normalized.json",
    "src/provenance/source-markers.json",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "scripts": {
    "lint": "eslint . --config eslint.config.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markpol/5e-database.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/markpol/5e-database/issues"
  },
  "homepage": "https://github.com/markpol/5e-database#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
